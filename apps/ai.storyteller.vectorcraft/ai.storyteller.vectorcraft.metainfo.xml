<?xml version="1.0" encoding="UTF-8"?>
<!-- Rendered from upstream's packaging/linux/ai.storyteller.vectorcraft.metainfo.xml.in
     at v0.6.0. omapak keeps this copy so the judge can lint it and the site
     catalog can read it; the flatpak installs the identical file that ships
     inside the release tarball.

     Screenshot URLs are pinned to the release tag rather than main, and any
     screenshot upstream's template pointed at a missing file was replaced
     with a real one from that repo's docs/images. -->
<component type="desktop-application">
  <id>ai.storyteller.vectorcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>VectorCraft</name>
  <summary>Draw and edit vector illustrations, SVG and PDF</summary>
  <developer id="ai.storyteller">
    <name>Learning Machines LLC</name>
  </developer>
  <description>
    <p>
      VectorCraft is an open-source vector illustration app. Draw with pen, shape and brush tools,
      style art with fills, strokes, gradients and live effects, lay out artboards and type, and
      open and save SVG and PDF.
    </p>
  </description>
  <launchable type="desktop-id">ai.storyteller.vectorcraft.desktop</launchable>
  <icon type="stock">ai.storyteller.vectorcraft</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://getartcraft.com/apps/vectorcraft</url>
  <url type="bugtracker">https://github.com/storytold/vectorcraft/issues</url>
  <url type="help">https://github.com/storytold/vectorcraft</url>
  <url type="contact">https://discord.gg/artcraft</url>
  <categories>
    <category>Graphics</category>
    <category>2DGraphics</category>
    <category>VectorGraphics</category>
  </categories>
  <keywords>
    <keyword>vector</keyword>
    <keyword>illustration</keyword>
    <keyword>svg</keyword>
    <keyword>pdf</keyword>
    <keyword>drawing</keyword>
    <keyword>bezier</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>Editing the Neon Drive poster with a live glow effect in the Appearance panel</caption>
      <image>https://raw.githubusercontent.com/storytold/vectorcraft/v0.6.0/docs/images/shot-1-neon.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>vectorcraft</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.6.0" date="2026-10-08"/>
  </releases>
</component>
