<?xml version="1.0" encoding="UTF-8"?>
<!-- Rendered from upstream's packaging/linux/ai.storyteller.designcraft.metainfo.xml.in
     at v0.4.0. omapak keeps this copy so the judge can lint it and the site
     catalog can read it; the flatpak installs the identical file that ships
