<?xml version="1.0" encoding="UTF-8"?>
<!-- Rendered from upstream's packaging/linux/ai.storyteller.wordcraft.metainfo.xml.in
     at v0.3.0. omapak keeps this copy so the judge can lint it and the site
     catalog can read it; the flatpak installs the identical file that ships
     inside the release tarball.

     Screenshot URLs are pinned to the release tag rather than main, and any
     screenshot upstream's template pointed at a missing file was replaced
     with a real one from that repo's docs/images. -->
<component type="desktop-application">
  <id>ai.storyteller.wordcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>WordCraft</name>
  <summary>Write and design documents; open and save Word files</summary>
  <developer id="ai.storyteller">
    <name>Learning Machines LLC</name>
  </developer>
  <description>
    <p>
      WordCraft is a fast, open-source word processor with a familiar ribbon: styles, tables, track changes, references, mail merge, and .docx, PDF, ODT, RTF, HTML and Markdown files. It can be driven by AI agents over MCP.
    </p>
  </description>
  <launchable type="desktop-id">ai.storyteller.wordcraft.desktop</launchable>
  <icon type="stock">ai.storyteller.wordcraft</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://getartcraft.com/apps/wordcraft</url>
  <url type="bugtracker">https://github.com/storytold/wordcraft/issues</url>
  <url type="help">https://github.com/storytold/wordcraft</url>
  <url type="contact">https://discord.gg/artcraft</url>
  <categories>
    <category>Office</category>
    <category>WordProcessor</category>
  </categories>
  <keywords>
    <keyword>word processor</keyword>
    <keyword>docx</keyword>
    <keyword>document</keyword>
    <keyword>writer</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>The Open Studio Handbook sample with the Navigation pane</caption>
      <image>https://raw.githubusercontent.com/storytold/wordcraft/v0.3.0/docs/images/hero.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#b9c7f5</color>
    <color type="primary" scheme_preference="dark">#2b47b5</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>wordcraft</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.3.0" date="2026-10-08"/>
  </releases>
</component>
