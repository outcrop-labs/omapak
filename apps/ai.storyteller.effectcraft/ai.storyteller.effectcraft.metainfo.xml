<?xml version="1.0" encoding="UTF-8"?>
<!-- Rendered from upstream's packaging/linux/ai.storyteller.effectcraft.metainfo.xml.in
     at v0.6.0. omapak keeps this copy so the judge can lint it and the site
     catalog can read it; the flatpak installs the identical file that ships
     inside the release tarball.

     Screenshot URLs are pinned to the release tag rather than main, and any
     screenshot upstream's template pointed at a missing file was replaced
     with a real one from that repo's docs/images. -->
<component type="desktop-application">
  <id>ai.storyteller.effectcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>EffectCraft</name>
  <summary>Motion graphics and visual effects compositor</summary>
  <developer id="ai.storyteller">
    <name>Learning Machines LLC</name>
  </developer>
  <description>
    <p>
      EffectCraft is an open-source motion graphics and visual effects compositor: layers with
      keyframes and a graph editor, masks and shapes, text animators, expressions, 3D cameras and
      lights, over 300 effects and a render queue, with GPU compositing.
    </p>
  </description>
  <launchable type="desktop-id">ai.storyteller.effectcraft.desktop</launchable>
  <icon type="stock">ai.storyteller.effectcraft</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://getartcraft.com/apps/effectcraft</url>
  <url type="bugtracker">https://github.com/storytold/effectcraft/issues</url>
  <url type="help">https://github.com/storytold/effectcraft</url>
  <url type="contact">https://discord.gg/artcraft</url>
  <categories>
    <category>Graphics</category>
    <category>RasterGraphics</category>
    <category>Photography</category>
  </categories>
  <keywords>
    <keyword>photo</keyword>
    <keyword>image editor</keyword>
    <keyword>psd</keyword>
    <keyword>layers</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>An intro composition with animated text, orbit rings and a glow, layered on the timeline</caption>
      <image>https://raw.githubusercontent.com/storytold/effectcraft/v0.6.0/docs/images/effectcraft-hero.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>effectcraft</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.6.0" date="2026-10-08"/>
  </releases>
</component>
