<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.keyoxide.Keyoxide</id>

  <name>Keyoxide</name>
  <summary>Verify decentralized cryptographic identities on the go</summary>

  <developer id="org.keyoxide">
    <name>Keyoxide</name>
  </developer>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>

  <description>
    <p>
      Keyoxide allows you to prove “ownership” of accounts on websites, domain
      names, IM, etc., regardless of your username.
    </p>
    <p>
      When you visit someone’s Keyoxide profile and see a green tick next to an
      account on some website, it was proven beyond doubt that the same person
      who set up this profile also holds that account.
    </p>
    <p>App features:</p>
    <ul>
      <li>Runs on Linux desktop and mobile</li>
      <li>Simple and straightforward UI</li>
      <li>Onboarding and guided tour</li>
      <li>Fully open source</li>
      <li>Supports fingerprint and email address as identifiers</li>
      <li>Supports fetching identities via keyservers and Web Key Directory</li>
      <li>Deep linking with openpgp4fpr and aspe URL schemes</li>
      <li>Search history</li>
      <li>Contacts feature</li>
      <li>ASP profile management: create, edit, delete, import, export profiles and add claims directly within the app</li>
      <li>Hide sensitive user profiles and protect them with authentication</li>
      <li>Add multiple PGP or ASP profiles</li>
      <li>Available in 11 languages</li>
    </ul>
  </description>

  <launchable type="desktop-id">org.keyoxide.Keyoxide.desktop</launchable>

