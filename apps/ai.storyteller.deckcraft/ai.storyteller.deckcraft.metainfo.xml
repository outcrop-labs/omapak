<?xml version="1.0" encoding="UTF-8"?>
<!-- Rendered from upstream's packaging/linux/ai.storyteller.deckcraft.metainfo.xml.in
     at v0.3.0. omapak keeps this copy so the judge can lint it and the site
     catalog can read it; the flatpak installs the identical file that ships
     inside the release tarball.

     Screenshot URLs are pinned to the release tag rather than main, and any
     screenshot upstream's template pointed at a missing file was replaced
     with a real one from that repo's docs/images. -->
<component type="desktop-application">
  <id>ai.storyteller.deckcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>DeckCraft</name>
  <summary>Create and present slide decks</summary>
  <developer id="ai.storyteller">
    <name>Learning Machines LLC</name>
  </developer>
  <description>
    <p>
      DeckCraft builds presentations and slide shows: themes, layouts, shapes, pictures,
      tables, charts, transitions and animations. It opens and saves PowerPoint (.pptx) files
      and presents them full screen with a presenter view.
    </p>
    <p>
      Every action is also a command that the command line and AI agents (through MCP) can drive.
    </p>
  </description>
  <launchable type="desktop-id">ai.storyteller.deckcraft.desktop</launchable>
  <icon type="stock">ai.storyteller.deckcraft</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://getartcraft.com/apps/deckcraft</url>
  <url type="bugtracker">https://github.com/storytold/deckcraft/issues</url>
  <url type="help">https://github.com/storytold/deckcraft</url>
  <url type="contact">https://discord.gg/artcraft</url>
  <categories>
    <category>Office</category>
    <category>Presentation</category>
  </categories>
  <keywords>
    <keyword>presentation</keyword>
    <keyword>slides</keyword>
    <keyword>slide show</keyword>
    <keyword>pptx</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>Editing a slide of shapes and connectors, with the sectioned slide navigator</caption>
      <image>https://raw.githubusercontent.com/storytold/deckcraft/v0.3.0/docs/images/editor.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#ffc9a8</color>
    <color type="primary" scheme_preference="dark">#b8471f</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>deckcraft</binary>
    <mediatype>application/x-deckcraft</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.3.0" date="2026-10-08"/>
  </releases>
</component>
