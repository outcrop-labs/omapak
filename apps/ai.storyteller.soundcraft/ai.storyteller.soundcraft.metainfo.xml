<?xml version="1.0" encoding="UTF-8"?>
<!-- Rendered from upstream's packaging/linux/ai.storyteller.soundcraft.metainfo.xml.in
     at v0.3.0. omapak keeps this copy so the judge can lint it and the site
     catalog can read it; the flatpak installs the identical file that ships
     inside the release tarball.

     Screenshot URLs are pinned to the release tag rather than main, and any
     screenshot upstream's template pointed at a missing file was replaced
     with a real one from that repo's docs/images. -->
<component type="desktop-application">
  <id>ai.storyteller.soundcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>SoundCraft</name>
  <summary>Record, edit and mix audio and MIDI</summary>
  <developer id="ai.storyteller">
    <name>Learning Machines LLC</name>
  </developer>
  <description>
    <p>
      SoundCraft is an open-source, native digital audio workstation. Record, edit and mix
      multitrack audio and MIDI in Edit and Mix windows that work the way studio engineers expect.
    </p>
    <ul>
      <li>Non-destructive clip editing with fades, playlists, grids and markers</li>
      <li>A mixer with inserts, sends, buses, automation and metering</li>
      <li>Built-in EQ, dynamics, reverb, delay, modulation and instruments</li>
      <li>Imports WAV, AIFF, FLAC, MP3 and MIDI; bounces to disk</li>
      <li>A headless command line and an MCP server for scripting and agents</li>
    </ul>
  </description>
  <launchable type="desktop-id">ai.storyteller.soundcraft.desktop</launchable>
  <icon type="stock">ai.storyteller.soundcraft</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://getartcraft.com/apps/soundcraft</url>
  <url type="bugtracker">https://github.com/storytold/soundcraft/issues</url>
  <url type="help">https://github.com/storytold/soundcraft</url>
  <url type="contact">https://discord.gg/artcraft</url>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
  </categories>
  <keywords>
    <keyword>daw</keyword>
    <keyword>audio</keyword>
    <keyword>mixer</keyword>
    <keyword>recording</keyword>
    <keyword>midi</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>The mixer with inserts, sends and faders across nine tracks, and a 7-band EQ open</caption>
      <image>https://raw.githubusercontent.com/storytold/soundcraft/v0.3.0/docs/images/mix.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#8fd9e6</color>
    <color type="primary" scheme_preference="dark">#0b7385</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>soundcraft</binary>
    <mediatype>application/x-soundcraft-session</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.3.0" date="2026-10-08"/>
  </releases>
</component>
