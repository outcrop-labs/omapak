<?xml version="1.0" encoding="UTF-8"?>
<!-- Rendered from upstream's packaging/linux/ai.storyteller.cadcraft.metainfo.xml.in
     at v0.3.0. omapak keeps this copy so the judge can lint it and the site
     catalog can read it; the flatpak installs the identical file that ships
     inside the release tarball.

     Screenshot URLs are pinned to the release tag rather than main, and any
     screenshot upstream's template pointed at a missing file was replaced
     with a real one from that repo's docs/images. -->
<component type="desktop-application">
  <id>ai.storyteller.cadcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>CADCraft</name>
  <summary>Draft, dimension and plot 2D drawings</summary>
  <developer id="ai.storyteller">
    <name>Learning Machines LLC</name>
  </developer>
  <description>
    <p>
      CADCraft is an open-source computer-aided design and drafting application with a familiar
      command line, object snaps, layers, dimensions, hatches and blocks. It opens and saves DXF
      and DWG drawings, exports SVG and PNG, and can be driven by AI agents over MCP.
    </p>
  </description>
  <launchable type="desktop-id">ai.storyteller.cadcraft.desktop</launchable>
  <icon type="stock">ai.storyteller.cadcraft</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://getartcraft.com/apps/cadcraft</url>
  <url type="bugtracker">https://github.com/storytold/cadcraft/issues</url>
  <url type="help">https://github.com/storytold/cadcraft</url>
  <url type="contact">https://discord.gg/artcraft</url>
  <categories>
    <category>Graphics</category>
    <category>Engineering</category>
  </categories>
  <keywords>
    <keyword>CAD</keyword>
    <keyword>drafting</keyword>
    <keyword>DXF</keyword>
    <keyword>DWG</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>A mechanical part drawing with dimensions, hatching and layers</caption>
      <image>https://raw.githubusercontent.com/storytold/cadcraft/v0.3.0/docs/images/ui-bracket.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#9ee3f2</color>
    <color type="primary" scheme_preference="dark">#0b6f88</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>cadcraft</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.3.0" date="2026-10-08"/>
  </releases>
</component>
